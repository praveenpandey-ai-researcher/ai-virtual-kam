# Copy this file to .env and fill in your values. Never commit .env.
# Primary voice: ElevenLabs. One or more API keys, comma-separated, in priority order.
# A call uses the first account with credits and moves down the list when one runs out.
ELEVENLABS_API_KEYS=
# Filled in by `python scripts/setup_agent.py` (one agent id per key, same order).
ELEVENLABS_AGENT_IDS=
# Fallback voice brain, used when every ElevenLabs account is exhausted: free key from console.groq.com
GROQ_API_KEY=
